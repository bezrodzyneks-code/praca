# Skopiuj do .env i dostosuj
PORT=8080
# 0.0.0.0 = dostępny dla innych urządzeń w sieci; 127.0.0.1 = tylko ten komputer
HOST=0.0.0.0
DATABASE_URL=postgres://kc:kc_password@localhost:5432/krolestwo
# Ustaw na "true", jeśli baza wymaga SSL (np. hosting zarządzany)
DATABASE_SSL=false
# Dozwolony origin dla CORS ("*" = wszystkie; w produkcji wpisz adres swojej strony)
CORS_ORIGIN=*
