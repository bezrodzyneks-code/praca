# Skopiuj do .env i dostosuj
PORT=8080
# 0.0.0.0 = dostępny dla innych urządzeń w sieci; 127.0.0.1 = tylko ten komputer
HOST=0.0.0.0
# Hasło wpisz TAKIE SAMO tu i w POSTGRES_PASSWORD (używa go docker-compose). Znaki specjalne zakoduj procentowo.
# W produkcji (NODE_ENV=production) serwer odmówi startu bez własnego hasła (min. 12 znaków).
DATABASE_URL=postgres://kc:USTAW_WLASNE_HASLO@localhost:5432/krolestwo
POSTGRES_PASSWORD=USTAW_WLASNE_HASLO
# Ustaw na "true", jeśli baza wymaga SSL (np. hosting zarządzany)
DATABASE_SSL=false
# Dozwolony origin dla CORS ("*" = wszystkie; w produkcji wpisz adres swojej strony)
CORS_ORIGIN=*
# Proxy przed aplikacją (nginx/Caddy/tunel): ustaw liczbę proxy, zwykle 1. Zostaw puste, jeśli serwer stoi bezpośrednio w sieci.
# Bez tego limity i logi używają adresu gniazda, a X-Forwarded-For jest ignorowany (nie da się go sfałszować).
# Uwaga: za proxy BEZ tej opcji wszyscy gracze mają wspólny adres IP, a więc wspólne limity.
TRUST_PROXY=
# Content-Security-Policy: domyślnie pełna polityka jest tylko raportowana w konsoli przeglądarki (F12).
# Gdy po przejściu gry i panelu admina nie widać komunikatów "Refused to ...", ustaw true.
CSP_ENFORCE=false
